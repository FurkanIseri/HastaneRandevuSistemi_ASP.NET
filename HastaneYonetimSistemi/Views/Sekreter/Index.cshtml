@{
    ViewData["Title"] = "Sekreter Paneli";
}

<div class="row g-4 fade-in">
    <div class="col-lg-3">
        <div class="card mb-3 border-0">
            <div class="card-body text-center p-4">
                <div class="mb-3">
                    <i class="fa-solid fa-user-nurse text-primary" style="font-size: 4rem; opacity: 0.8;"></i>
                </div>
                <h5 class="fw-bold mb-1">@ViewBag.AdSoyad</h5>
                <p class="text-muted small mb-0"><i class="fa-solid fa-id-badge me-2"></i>Sistem Yöneticisi</p>
            </div>
        </div>

        <div class="card border-0">
            <div class="card-body p-3">
                <p class="text-muted small fw-semibold text-uppercase px-2 mb-2">Yönetim</p>
                <div class="list-group list-group-flush gap-1">
                    <a href="/Sekreter/DoktorListesi" class="list-group-item list-group-item-action border-0 rounded-3 py-2 px-3">
                        <i class="fa-solid fa-user-doctor text-primary me-2"></i>Doktor Yönetimi
                    </a>
                    <a href="/Sekreter/DoktorEkle" class="list-group-item list-group-item-action border-0 rounded-3 py-2 px-3 ps-4 text-muted small">
                        <i class="fa-solid fa-plus me-2"></i>Yeni Doktor Ekle
                    </a>
                    <a href="/Sekreter/BransYonetimi" class="list-group-item list-group-item-action border-0 rounded-3 py-2 px-3">
                        <i class="fa-solid fa-stethoscope text-primary me-2"></i>Branş Yönetimi
                    </a>
                    <a href="/Sekreter/IlacYonetimi" class="list-group-item list-group-item-action border-0 rounded-3 py-2 px-3">
                        <i class="fa-solid fa-pills text-primary me-2"></i>İlaç Yönetimi
                    </a>
                    <a href="/Sekreter/SekreterYonetimi" class="list-group-item list-group-item-action border-0 rounded-3 py-2 px-3">
                        <i class="fa-solid fa-user-nurse text-primary me-2"></i>Sekreter Yönetimi
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-9">
        <div class="row g-3">
            <div class="col-12">
                <div class="card border-0">
                    <div class="card-header bg-transparent border-bottom-0 pt-4 pb-0">
                        <h5 class="fw-bold"><i class="fa-solid fa-bullhorn text-secondary me-2"></i>Duyuru Yayınla</h5>
                    </div>
                    <div class="card-body p-4">
                        <div class="row g-3 align-items-end">
                            <div class="col-md-9">
                                <label class="form-label text-muted small fw-semibold text-uppercase">Duyuru İçeriği</label>
                                <textarea id="txtDuyuru" class="form-control border-0 bg-light" rows="2"
                                          placeholder="Tüm personele gönderilecek duyuru metnini yazın..."></textarea>
                            </div>
                            <div class="col-md-3">
                                <button id="btnDuyuruOlustur" class="btn btn-outline-primary w-100 py-2 rounded-pill fw-medium">
                                    <i class="fa-solid fa-paper-plane me-2"></i>Yayınla
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12">
                <div class="card border-0">
                    <div class="card-header bg-transparent border-bottom-0 pt-4 pb-0">
                        <h5 class="fw-bold"><i class="fa-solid fa-calendar-plus text-primary me-2"></i>Yeni Randevu Yuvası Oluştur</h5>
                    </div>
                    <div class="card-body p-4">
                        <div class="row g-3">
                            <div class="col-md-3">
                                <label class="form-label text-muted small fw-semibold text-uppercase">Tarih</label>
                                <input type="date" id="txtTarih" class="form-control border-0 bg-light" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label text-muted small fw-semibold text-uppercase">Saat</label>
                                <input type="time" id="txtSaat" class="form-control border-0 bg-light" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label text-muted small fw-semibold text-uppercase">Klinik / Branş</label>
                                <select id="cmbBrans" class="form-select border-0 bg-light">
                                    <option value="">Seçiniz</option>
                                    @if (ViewBag.Branslar != null)
                                    {
                                        foreach (var b in ViewBag.Branslar)
                                        {
                                            <option value="@b">@b</option>
                                        }
                                    }
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label text-muted small fw-semibold text-uppercase">Doktor</label>
                                <select id="cmbDoktor" class="form-select border-0 bg-light">
                                    <option value="">Önce Branş Seçiniz</option>
                                </select>
                            </div>
                        </div>
                        <div class="mt-3">
                            <button id="btnRandevuOlustur" class="btn btn-primary px-5 py-2 rounded-pill shadow-sm fw-bold">
                                <i class="fa-solid fa-plus me-2"></i>Yuva Oluştur
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    $(document).ready(function() {
        $('#cmbBrans').change(function() {
            var brans = $(this).val();
            $('#cmbDoktor').empty().append('<option value="">Doktor Seçiniz</option>');
            if (brans) {
                $.getJSON('/Sekreter/GetDoktorlarByBrans', { brans }, function(data) {
                    $.each(data, function(i, d) {
                        $('#cmbDoktor').append($('<option>').val(d.id).text(d.ad));
                    });
                });
            }
        });

        $('#btnDuyuruOlustur').click(function() {
            var duyuru = $('#txtDuyuru').val().trim();
            if (!duyuru) { Swal.fire({ icon:'warning', title:'Eksik Bilgi', text:'Duyuru metni boş olamaz.', confirmButtonColor:'#0e7490' }); return; }
            $.post('/Sekreter/DuyuruOlustur', { duyuru }, function(res) {
                if (res.success) {
                    Swal.fire({ icon:'success', title:'Başarılı', text:res.message, confirmButtonColor:'#10b981' });
                    $('#txtDuyuru').val('');
                } else { Swal.fire('Hata', res.message, 'error'); }
            });
        });

        $('#btnRandevuOlustur').click(function() {
            var tarih = $('#txtTarih').val(), saat = $('#txtSaat').val();
            var brans = $('#cmbBrans').val(), doktorId = $('#cmbDoktor').val();
            if (!tarih || !saat || !brans || !doktorId) {
                Swal.fire({ icon:'warning', title:'Eksik Form', text:'Tüm alanları doldurun.', confirmButtonColor:'#0e7490' });
                return;
            }
            $.post('/Sekreter/RandevuOlustur', { tarih, saat, brans, doktorId }, function(res) {
                if (res.success) {
                    Swal.fire({ icon:'success', title:'İşlem Başarılı', text:res.message, confirmButtonColor:'#10b981' })
                        .then(() => { $('#txtTarih').val(''); $('#txtSaat').val(''); });
                } else { Swal.fire({ icon:'error', title:'Hata', text:res.message, confirmButtonColor:'#ef4444' }); }
            });
        });
    });
</script>
}
