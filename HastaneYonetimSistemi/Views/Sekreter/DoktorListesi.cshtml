@model IEnumerable<HastaneYonetimSistemi.Models.DoktorListeItem>
@{
    ViewData["Title"] = "Doktor Listesi";
}

<div class="row g-4 fade-in">
    <div class="col-12">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <div>
                <h4 class="fw-bold mb-1"><i class="fa-solid fa-user-doctor text-primary me-2"></i>Kayıtlı Doktorlar</h4>
                <p class="text-muted small mb-0">Sistemdeki tüm doktorların listesi.</p>
            </div>
            <div class="d-flex gap-2">
                <a href="/Sekreter/DoktorEkle" class="btn btn-primary rounded-pill px-4 fw-medium">
                    <i class="fa-solid fa-user-plus me-2"></i>Yeni Doktor Ekle
                </a>
                <a href="/Sekreter/Index" class="btn btn-outline-secondary rounded-pill px-4 fw-medium">
                    <i class="fa-solid fa-arrow-left me-2"></i>Panele Dön
                </a>
            </div>
        </div>

        <div class="row mb-3 align-items-center">
            <div class="col-md-6 offset-md-6">
                <div class="input-group shadow-sm rounded-pill overflow-hidden">
                    <span class="input-group-text border-0 bg-white ps-4">
                        <i class="fa-solid fa-magnifying-glass text-muted"></i>
                    </span>
                    <input type="text" id="searchInput" class="form-control border-0 py-2 ps-2" placeholder="Doktor ara (Ad veya Branş)..." />
                </div>
            </div>
        </div>

        <div class="card border-0">
            <div class="card-body p-0">
                @if (Model == null || !Model.Any())
                {
                    <div class="text-center py-5">
                        <i class="fa-solid fa-user-doctor fa-3x text-black-50 mb-3 d-block"></i>
                        <h6 class="fw-bold text-muted">Kayıtlı Doktor Bulunamadı</h6>
                        <p class="text-muted small mb-3">Sisteme henüz doktor eklenmemiştir.</p>
                        <a href="/Sekreter/DoktorEkle" class="btn btn-primary rounded-pill px-4">İlk Doktoru Ekle</a>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-4">Profil</th>
                                    <th>Ad Soyad</th>
                                    <th>Uzmanlık Branşı</th>
                                    <th class="pe-4 text-end">İşlemler</th>
                                </tr>
                            </thead>
                            <tbody id="tableBody" class="border-top-0">
                                @foreach (var d in Model)
                                {
                                    <tr>
                                        <td class="ps-4">
                                            @if (!string.IsNullOrEmpty(d.ProfilFotoBase64))
                                            {
                                                <img src="@d.ProfilFotoBase64" alt="@d.AdSoyad"
                                                     class="rounded-circle shadow-sm"
                                                     style="width: 48px; height: 48px; object-fit: cover;" />
                                            }
                                            else
                                            {
                                                <div class="d-inline-flex align-items-center justify-content-center bg-primary bg-opacity-10 text-primary rounded-circle"
                                                     style="width: 48px; height: 48px; font-size: 1.2rem;">
                                                    <i class="fa-solid fa-user-doctor"></i>
                                                </div>
                                            }
                                        </td>
                                        <td class="fw-medium">Dr. @d.AdSoyad</td>
                                        <td>
                                            <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-3 py-2">
                                                <i class="fa-solid fa-stethoscope me-1"></i>@d.Brans
                                            </span>
                                        </td>
                                        <td class="pe-4 text-end">
                                            @if (d.SekreterId == ViewBag.CurrentSekreterId)
                                            {
                                                <a href="/Sekreter/DoktorDuzenle?doktorId=@d.DoktorId"
                                                   class="btn btn-sm btn-outline-primary rounded-pill px-3 fw-medium me-1">
                                                    <i class="fa-solid fa-pen me-1"></i>Düzenle
                                                </a>
                                                <button class="btn btn-sm btn-outline-danger rounded-pill px-3 fw-medium btn-sil"
                                                        data-id="@d.DoktorId" data-ad="@d.AdSoyad">
                                                    <i class="fa-solid fa-trash me-1"></i>Sil
                                                </button>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary bg-opacity-10 text-secondary rounded-pill px-3 py-2 me-1" 
                                                      title="Başka Sekreter Ekledi" style="cursor: help;">
                                                    <i class="fa-solid fa-lock me-1"></i>Başka Sekreter
                                                </span>
                                                <button class="btn btn-sm btn-outline-secondary rounded-pill px-3 fw-medium disabled" 
                                                        style="opacity: 0.5;" title="Yetkiniz yok">
                                                    <i class="fa-solid fa-ban me-1"></i>Kilitli
                                                </button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $("#searchInput").on("keyup", function() {
                var value = $(this).val().toLowerCase();
                $("#tableBody tr").filter(function() {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1)
                });
            });
        });
    </script>
}
