@{
    ViewData["Title"] = "Doktor Şifremi Unuttum";
}

<div class="row justify-content-center align-items-center min-vh-100 fade-in" style="margin-top: -80px;">
    <div class="col-md-6 col-lg-5 col-xl-4">
        <div class="card border-0 shadow-lg" style="border-radius: 1.5rem;">
            <div class="card-body p-5">
                <div class="text-center mb-4">
                    <div class="d-inline-flex align-items-center justify-content-center bg-primary bg-opacity-10 text-primary rounded-circle mb-3" style="width: 80px; height: 80px;">
                        <i class="fa-solid fa-key fa-2x"></i>
                    </div>
                    <h3 class="fw-bold text-dark">Şifremi Unuttum</h3>
                    <p class="text-muted small">Doktor TC Kimlik Numaranızı girerek şifrenizi öğrenebilirsiniz.</p>
                </div>
                
                @if (ViewBag.Mesaj != null)
                {
                    <div class="alert alert-success text-center fw-bold shadow-sm rounded-3 mb-4" role="alert">
                        <i class="fa-solid fa-check-circle me-2"></i>@ViewBag.Mesaj
                    </div>
                }

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger text-center fw-medium shadow-sm rounded-3 mb-4" role="alert">
                        <i class="fa-solid fa-circle-exclamation me-2"></i>@ViewBag.Error
                    </div>
                }

                <form asp-action="DoktorSifremiUnuttum" method="post">
                    <div class="mb-4">
                        <label class="form-label text-muted small fw-semibold text-uppercase">TC Kimlik No</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-0"><i class="fa-solid fa-id-card text-muted"></i></span>
                            <input name="tc" class="form-control form-control-lg bg-light border-0" placeholder="11 Haneli TC Kimlik No" maxlength="11" required />
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary btn-lg w-100 py-3 mb-4 rounded-pill fw-bold shadow-sm">Şifremi Getir</button>
                    
                    <div class="text-center">
                        <a href="/Auth/DoktorGiris" class="text-muted text-decoration-none small"><i class="fa-solid fa-arrow-left me-1"></i> Giriş Ekranına Dön</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
