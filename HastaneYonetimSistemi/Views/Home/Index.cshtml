@{
    ViewData["Title"] = "Ana Sayfa";
}

<div class="row justify-content-center mt-5 text-center">
    <div class="col-12 mb-5">
        <h1 class="display-4 fw-bold" style="color: #008080;">
            <i class="fa-solid fa-hospital me-2"></i>Hastane Randevu Sistemi
        </h1>
        <p class="lead text-muted mt-3">Lütfen giriş yapmak istediğiniz modülü seçiniz.</p>
    </div>

    <div class="col-md-4 mb-4">
        <div class="card shadow-lg h-100 border-0 rounded-4 feature-card">
            <div class="card-body py-5">
                <i class="fa-solid fa-hospital-user fa-5x mb-4" style="color: #008080;"></i>
                <h3 class="fw-bold mb-3">Hasta Modülü</h3>
                <p class="text-muted mb-4">Randevu almak ve geçmiş işlemlerinizi görüntülemek için giriş yapın.</p>
                <a href="/Auth/HastaGiris" class="btn btn-turquoise btn-lg w-100 rounded-pill fw-bold">Hasta Girişi</a>
            </div>
        </div>
    </div>

    <div class="col-md-4 mb-4">
        <div class="card shadow-lg h-100 border-0 rounded-4 feature-card">
            <div class="card-body py-5">
                <i class="fa-solid fa-user-doctor fa-5x mb-4 text-primary"></i>
                <h3 class="fw-bold mb-3">Doktor Modülü</h3>
                <p class="text-muted mb-4">Randevularınızı yönetmek ve reçete yazmak için giriş yapın.</p>
                <a href="/Auth/DoktorGiris" class="btn btn-primary btn-lg w-100 rounded-pill fw-bold">Doktor Girişi</a>
            </div>
        </div>
    </div>

    <div class="col-md-4 mb-4">
        <div class="card shadow-lg h-100 border-0 rounded-4 feature-card">
            <div class="card-body py-5">
                <i class="fa-solid fa-user-nurse fa-5x mb-4 text-success"></i>
                <h3 class="fw-bold mb-3">Sekreter Modülü</h3>
                <p class="text-muted mb-4">Sistem ayarlarını yapılandırmak ve duyuru yayınlamak için giriş yapın.</p>
                <a href="/Auth/SekreterGiris" class="btn btn-success btn-lg w-100 rounded-pill fw-bold">Sekreter Girişi</a>
            </div>
        </div>
    </div>
</div>

<style>
    .feature-card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    .feature-card:hover {
        transform: translateY(-10px);
        box-shadow: 0 15px 30px rgba(0,0,0,0.15) !important;
    }
</style>