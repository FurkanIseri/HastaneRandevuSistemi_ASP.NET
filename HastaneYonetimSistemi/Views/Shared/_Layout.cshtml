<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Hastane Randevu Sistemi</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11.7.3/dist/sweetalert2.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <link href="~/css/site.css" rel="stylesheet" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-custom py-3 sticky-top">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center" href="/">
                    <i class="fa-solid fa-hospital-user me-2 fs-3 text-primary"></i>
                    <span class="text-primary fw-bold">SağlıkSistemi+</span>
                </a>
                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav ms-auto align-items-center">
                        <li class="nav-item">
                            @{
                                string anaSayfaHref = "/";
                                if (Context.Session.GetString("SekreterTC") != null)
                                    anaSayfaHref = "/Sekreter/Index";
                                else if (Context.Session.GetString("DoktorTC") != null)
                                    anaSayfaHref = "/Doktor/Index";
                                else if (Context.Session.GetString("HastaTC") != null)
                                    anaSayfaHref = "/Hasta/Index";
                            }
                            <a class="nav-link fw-medium" href="@anaSayfaHref"><i class="fa-solid fa-house me-1"></i> Ana Sayfa</a>
                        </li>
                        @if (Context.Session.Keys.Any(k => k.EndsWith("TC")))
                        {
                            <li class="nav-item ms-lg-3 mt-3 mt-lg-0">
                                <a class="btn btn-outline-danger btn-sm rounded-pill px-4 fw-bold" href="/Auth/Logout">
                                    <i class="fa-solid fa-right-from-bracket me-1"></i> Çıkış Yap
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container my-5">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.7.3/dist/sweetalert2.all.min.js"></script>

    <script>
        $(document).ready(function() {
            $('form, input').attr('autocomplete', 'off');

        @if (TempData["Message"] != null)
        {
            <text>
                    Swal.fire({
                        icon: 'success',
                        title: 'Başarılı!',
                        text: '@Html.Raw(TempData["Message"])',
                        confirmButtonColor: '#008080'
                    });
            </text>
        }

        @if (ViewBag.Error != null)
        {
            <text>
                    Swal.fire({
                        icon: 'error',
                        title: 'Hata!',
                        text: '@Html.Raw(ViewBag.Error)',
                        confirmButtonColor: '#d33'
                    });
            </text>
        }

        @if (TempData["Error"] != null)
        {
            <text>
                    Swal.fire({
                        icon: 'error',
                        title: 'Hata!',
                        text: '@Html.Raw(TempData["Error"])',
                        confirmButtonColor: '#d33'
                    });
            </text>
        }
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>